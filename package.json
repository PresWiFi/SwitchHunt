{
  "name": "switchhunt",
  "version": "1.0.0",
  "type": "module",
  "description": "Drop a Windows installer in your browser, get its silent-install switches. Analysis is client-side; the optional server builds .intunewin packages of any size on disk.",
  "license": "MIT",
  "homepage": "https://github.com/preswifi/SwitchHunt",
  "repository": {
    "type": "git",
    "url": "https://github.com/preswifi/SwitchHunt.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node server/main.ts",
    "test:server": "node scripts/test-server-package.ts",
    "gen:catalog": "tsx scripts/gen-catalog.ts",
    "astro": "astro",
    "check:parity": "node scripts/check-lib-parity.mjs",
    "test:secrets": "tsx scripts/test-secret-params.ts"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
